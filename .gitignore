# Unreal Engine generated folders
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
.vscode/
.idea/

# Visual Studio / Rider / IDE files
.vs/
*.sln
*.suo
*.user
*.userprefs
*.VC.db
*.VC.opendb
*.opensdf
*.sdf
*.pdb
*.opendb
*.db

# Unreal project files and generated metadata
*.tmp
*.temp
*.log
*.bak
*.orig
*.swp
*.swo
*.patch
*.code-workspace

# Generated build and packaging output
*.generated.h
*.gen.cpp
*.pak
*.utoc
*.ucas
*.ushaderbytecode
