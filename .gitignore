# Unreal autosaves and local editor state
Saved/
Autosaves/
Collections/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Large local exports and profiling captures
*.csv
*.json
*.uprojectdirs

# Keep source-controlled project descriptors and configuration
!Config/*.ini
!Config/*.xml
!Source/
!Content/

# Keep all user-supplied source-pack metadata under the project asset library.
!Assets/FireCastle/SourcePackage/Documentation/*.json
!Assets/FireCastle/SourcePackage/Materials/*.json
